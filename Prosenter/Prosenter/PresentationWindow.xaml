<Window x:Class="Prosenter.PresentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:Prosenter"
        mc:Ignorable="d"
        Title="PresentationWindow" Height="450" Width="800"
        SizeToContent="Height"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        >
    <Window.Background>
        <SolidColorBrush Color="#FFFAF3F0"  Opacity="0.75"></SolidColorBrush>
    </Window.Background>
    <DockPanel LastChildFill="False">
        <StackPanel Height="Auto" DockPanel.Dock="Top" Orientation="Horizontal" Opacity="1" x:Name="Presentation_Controls" Background="#FF93A093">
            <TextBlock FontWeight="ExtraBold" Text="Title Settings" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White" Margin="10" Height="Auto" Width="Auto" FontFamily="Trebuchet MS"></TextBlock>
            <TextBlock Text="Font Color" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10" Height="Auto" Foreground="White" Width="Auto" FontFamily="Trebuchet MS"></TextBlock>
            <xctk:ColorPicker  x:Name="Presentation_FontColorPicker" SelectedColor="Black" Width="50" Height="30" SelectedColorChanged="Presentation_FontColorPicker_SelectedColorChanged" ColorMode="ColorCanvas"></xctk:ColorPicker>
            <TextBlock Text="Stroke Color" VerticalAlignment="Center" HorizontalAlignment="Left" Height="Auto" Margin="10" Width="Auto" Foreground="White" FontFamily="Trebuchet MS"></TextBlock>
            <xctk:ColorPicker  Name="Presentation_StrokeColorPicker" Foreground="White"  SelectedColor="White" Width="50" Height="30" SelectedColorChanged="Presentation_StrokeColorPicker_SelectedColorChanged" FontFamily="Trebuchet MS" ColorMode="ColorCanvas"></xctk:ColorPicker>
            <TextBlock Text="Font" VerticalAlignment="Center" HorizontalAlignment="Left"  Height="Auto" Width="Auto" Margin="10" Foreground="White" FontFamily="Trebuchet MS"></TextBlock>
            <ComboBox x:Name="Presentation_Font" Width="Auto" Height="Auto" Margin="10" SelectedIndex="0" ItemsSource="{Binding Source={x:Static Fonts.SystemFontFamilies}}" SelectionChanged="Presentation_Font_SelectionChanged" BorderBrush="{x:Null}">
                <ComboBox.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FF80DFEB" Offset="1"/>
                    </LinearGradientBrush>
                </ComboBox.Background>
            </ComboBox>
            <TextBlock Text="Font Size" VerticalAlignment="Center" HorizontalAlignment="Left"  Height="Auto" Width="Auto" Foreground="White" FontFamily="Trebuchet MS"></TextBlock>
            <Slider x:Name="Presentation_FontSize" Minimum="8" Maximum="400" Value="40" Width="200" Height="Auto" Margin="10" Foreground="White" ValueChanged="Presentation_FontSize_ValueChanged"></Slider>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" VerticalAlignment="Bottom">
            <local:OutlinedTextBlock DockPanel.Dock="Top" x:Name="Presentation_Number" StrokeThickness="2" Stroke="White" Opacity="0.5"  FontSize="20"  Text="Longest title below" VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="Auto" Width="Auto"/>
            <local:OutlinedTextBlock x:Name="Presentation_Text" StrokeThickness="4" Stroke="White" FontSize="40" Text="Lorem Ipsum" VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="Auto" Width="Auto" TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>

</Window>
