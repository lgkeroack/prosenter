<Window x:Class="Prosenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prosenter"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Presenter Window" SizeToContent="WidthAndHeight"
        AllowDrop="True"
        Drop="Window_Drop"
        >
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#f4c4ca"/>
            <GradientStop Offset="1" Color="#b6d5b6"/>
        </LinearGradientBrush>
    </Window.Background>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
        <StackPanel x:Name="ImportPanel"  Orientation="Vertical" Width="800" Height="400" VerticalAlignment="Center">
            <TextBlock Text="Drag a CSV of the correct format here to begin" Padding="10,10,10,10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0"></TextBlock>
            <TextBlock Text="or" Foreground="White" Padding="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            <Button x:Name="ImportButton"
        Click="LoadNewFile"
        Content="Import a file"
        Margin="200,10,200,10"
        Padding="10,10,10,10"
        Background="#FFFAF3F0"
        RenderTransformOrigin="0.5,0.5"
        BorderThickness="0"
        BorderBrush="{x:Null}"
        Height="50">
                <!-- Adjusted Height -->
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
        <DockPanel x:Name="MainContent" Visibility="Collapsed" >
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_Import New File" Click="LoadNewFile" />
                    <Separator />
                    <MenuItem Header="_Report an Issue"  Click="ReportIssue"/>
                    
                </MenuItem>
            </Menu>

            <StackPanel Orientation="Vertical" >
                <Grid Width="Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Column="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Button  Grid.Column="0" Grid.Row="0" Margin="12,20,12,20" Foreground="White"  x:Name="Main_StartButton" Background="Transparent" FontSize="20" FontWeight="ExtraBold" Click="Main_StartButton_Click"  Content="STAGE" ToolTip="CTRL + Enter | Start by staging your presentation area" Padding="20,10,20,10" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" RenderTransformOrigin="1,0" BorderBrush="{x:Null}" FontFamily="Trebuchet MS" />
                            <Button Grid.Column="0" Grid.Row="1" Margin="10" x:Name="Main_UpButton" Click="Main_UpButton_Click"   FontSize="20" Width="40" Height="40" ToolTip="CTRL + ↑ | Move to the previous title" Padding="30,6,30,6" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="{x:Null}" >
                                <Button.Background>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>
                                            <Canvas >
                                                <Path Fill="#00000000" Stroke="White" StrokeThickness="20" Data="M250.228,129.7l121.74,210.859H128.489Z"  />
                                            </Canvas>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Button.Background>
                            </Button>
                            <Button Grid.Column="0" Grid.Row="2" Margin="20" x:Name="Main_StopButton"  Click="Main_StopButton_Click" FontWeight="ExtraBold" Width="Auto" Height="Auto" FontSize="20" Content ="STOP" Background="Transparent" ToolTip="CTRL + Backspace | Stop the presentation and close the title window" Padding="30,6,30,6" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="White" BorderBrush="{x:Null}" FontFamily="Trebuchet MS" />
                            <Button Grid.Column="0" Grid.Row="3" Margin="10" x:Name="Main_DownButton" Click="Main_DownButton_Click"  Width="40" Height="40" FontSize="20" ToolTip="CTRL + ↓ Key | Move to the next title" Padding="30,6,30,6" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="{x:Null}" >
                                <Button.Background>
                                    <VisualBrush Stretch="Uniform">
                                        <VisualBrush.Visual>
                                            <Canvas >
                                                <Path Fill="#00000000" Stroke="White" StrokeThickness="20" Data="M249.772,370.3L128.032,159.443H371.511Z"  />
                                            </Canvas>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Button.Background>
                            </Button>
                            <TextBlock x:Name="StartBindingTip" Text="CTRL + ENTER" FontSize="10" Foreground="LightGray" Grid.Column="1" Grid.Row="0" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UpBindingTip" Text="CTRL + ↑" FontSize="10" Foreground="LightGray" Grid.Column="1" Grid.Row="1" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StopBindingTip" Text="CTRL + BACK" FontSize="10" Foreground="LightGray" Grid.Column="1" Grid.Row="2" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DownBindingTip" Text="CTRL + ↓" FontSize="10" Foreground="LightGray" Grid.Column="1" Grid.Row="3" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Grid>
                    </StackPanel>
                    <ListView x:Name="Main_ItemsList" Grid.Column="1" Grid.Row="0" Margin="30,41,10,10" Width="Auto" MinWidth="300" Height="Auto" BorderThickness="0,0,0,0" ScrollViewer.CanContentScroll="False" Background="Transparent" SelectionMode="Single" SelectionChanged="Main_ItemsList_SelectionChanged" Foreground="White" FontWeight="Bold" ScrollViewer.HorizontalScrollBarVisibility="Auto" Padding="0.5,0.5,0.5,0.5">

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" DisplayMemberBinding="{Binding Number}" Width="Auto"/>
                                <GridViewColumn Header="Title"  Width="Auto"  DisplayMemberBinding="{Binding Title}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
                <TextBlock Margin="20" FontSize="10"  Padding="20,20,20,20" x:Name="Main_BottomStatus" Foreground= "White" TextWrapping="Wrap" Width="Auto" Height="Auto" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Margin="10" Text="Notes size" HorizontalAlignment="Right" FontWeight="Bold"   Foreground="White" FontFamily="Trebuchet MS"></TextBlock>
                    <xctk:IntegerUpDown Margin="10" x:Name="Main_NotesSize" Value="20" Minimum="10" Maximum="100" ValueChanged="Main_NotesSize_ValueChanged" AllowSpin="True"></xctk:IntegerUpDown>
                </StackPanel>
                <TextBlock Padding="20,20,20,20" MinWidth="200"  x:Name="Main_Notes"  Text="Import a .csv by dragging it over this window to begin" TextWrapping="Wrap" Width="Auto" Height="Auto" MaxWidth="500" Foreground="Black" FontWeight="Bold" Margin="0,0,10,0" Background="#FFD4E2D4" FontFamily="Trebuchet MS"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>

